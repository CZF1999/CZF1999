{
  "name": "@caf/element-plus-wrapper",
  "version": "1.0.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/element-plus-wrapper.umd.js",
  "module": "dist/element-plus-wrapper.es.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/element-plus-wrapper.es.js",
      "require": "./dist/element-plus-wrapper.umd.js",
      "types": "./dist/types/index.d.ts"
    },
    "./dist/style.css": "./dist/style.css",
    "./*": {
      "import": "./dist/*/index.mjs",
      "types": "./dist/types/*/index.d.ts"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vite build --mode umd && pnpm build:types",
    "build:esm": "vite build",
    "build:umd": "vite build --mode umd",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "element-plus": ">=2.0.0",
    "vue": ">=3.3.0"
  },
  "devDependencies": {
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^5.0.5",
    "sass": "^1.99.0",
    "sortablejs": "^1.15.7",
    "typescript": "^5.4.5",
    "vite": "^5.2.12",
    "vue-tsc": "^2.0.21"
  }
}
